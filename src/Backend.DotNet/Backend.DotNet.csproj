<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>FanucRmiDemo</AssemblyName>
    <RootNamespace>FanucRmiDemo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The published executable is the only file: no web.config, no static web assets manifest -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ApplicationIcon>ua.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release: one executable that contains the .NET runtime, so nothing is installed on the PC -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- The trial license of the SDK needs the real files of the assemblies: they are extracted at startup -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnderAutomation.Fanuc" Version="7.1.*" />
    <PackageReference Include="Spectre.Console" Version="0.49.*" />
  </ItemGroup>

  <!-- The web page is embedded in the executable, so the single file is the whole demo -->
  <ItemGroup>
    <EmbeddedResource Include="..\Client\**" LogicalName="Client/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
